        "required": ["id", "name", "kind"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "$ref": "#/components/schemas/StepKind" },
          "config": { "type": "object" },
          "next_default": { "type": "string", "nullable": true },
          "next_on": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      },
      "RetrievalSourceConfig": {
        "type": "object",
        "required": ["id", "name", "kind"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["http_api", "json_set"] },
          "config": { "type": "object" }
        }
      },
      "SmeRule": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "enabled": { "type": "boolean", "default": true }
        }
      },
      "LessonQuestion": {
        "type": "object",
        "required": ["id", "title", "question", "answer"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "question": { "type": "string" },
          "answer": { "type": "string" },
          "image_url": { "type": "string", "nullable": true }
        }
      },
      "LessonConfig": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "visual_verify": { "type": "boolean", "default": true },
          "questions": { "type": "array", "items": { "$ref": "#/components/schemas/LessonQuestion" } }
        }
      },
      "SmeTemplateResponse": {
        "type": "object",
        "required": ["id", "name", "soul", "steps", "sources", "rules", "is_default"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "soul": { "type": "string" },
          "steps": { "type": "array", "items": { "$ref": "#/components/schemas/ReasoningStep" } },
          "sources": { "type": "array", "items": { "$ref": "#/components/schemas/RetrievalSourceConfig" } },
          "rules": { "type": "array", "items": { "$ref": "#/components/schemas/SmeRule" } },
          "is_default": { "type": "boolean" },
          "lesson": { "$ref": "#/components/schemas/LessonConfig" }
        }
      },
      "SaveSmeTemplateRequest": {
        "type": "object",
        "required": ["id", "name", "soul"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "soul": { "type": "string" },
          "steps": { "type": "array", "items": { "$ref": "#/components/schemas/ReasoningStep" } },
          "sources": { "type": "array", "items": { "$ref": "#/components/schemas/RetrievalSourceConfig" } },
          "rules": { "type": "array", "items": { "$ref": "#/components/schemas/SmeRule" } },
          "is_default": { "type": "boolean", "default": false },
          "lesson": { "$ref": "#/components/schemas/LessonConfig" }
