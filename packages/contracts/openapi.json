          "name": { "type": "string" },
          "description": { "type": "string" },
          "wraps": { "type": "string" },
          "params": { "type": "array", "items": { "type": "string" }, "default": [] }
        }
      },
      "McpToolInfo": {
        "type": "object",
        "required": ["name", "description", "wraps"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "wraps": { "type": "string" },
          "input_schema": { "type": "object", "default": {} }
        }
