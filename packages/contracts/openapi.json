      "StartConversationResponse": {
        "type": "object",
        "required": ["conversation_id", "sme_id", "created_at"],
        "properties": {
          "conversation_id": { "type": "string" },
          "sme_id": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "MessageResponse": {
        "type": "object",
        "required": ["id", "role", "content", "created_at", "token_count", "citations"],
        "properties": {
          "id": { "type": "string" },
          "role": { "type": "string", "enum": ["user", "assistant", "system"] },
          "content": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "token_count": { "type": "integer" },
          "citations": { "type": "array", "items": { "type": "object" } }
