      "McpStatusResponse": {
        "type": "object",
        "required": ["mounted", "resources", "tools", "sme_template_count", "conversations_touched_count"],
        "properties": {
          "mounted": { "type": "boolean" },
          "mount_path": { "type": "string", "default": "/mcp" },
          "resources": { "type": "array", "items": { "$ref": "#/components/schemas/McpResourceInfo" } },
          "tools": { "type": "array", "items": { "$ref": "#/components/schemas/McpToolInfo" } },
          "sme_template_count": { "type": "integer" },
          "conversations_touched_count": { "type": "integer" }
        }
      },
      "McpReadResourceRequest": {
        "type": "object",
        "required": ["uri"],
        "properties": { "uri": { "type": "string" } }
      },
      "McpCallToolRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "arguments": { "type": "object", "default": {} }
        }
