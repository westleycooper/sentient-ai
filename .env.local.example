# Copy to .env.local and fill in values. Never commit .env.local (CLAUDE.md §9).

DATABASE_URL=postgresql://sentinel:sentinel_dev@localhost:5432/sentinel
ANTHROPIC_API_KEY=sk-ant-...           # required — console.anthropic.com
LLM_MODEL=claude-sonnet-4-6
ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Speech-to-Text (STT)
#
# RECOMMENDATION for most realistic conversational feel:
#   STT_PROVIDER=deepgram  — lowest latency, best accuracy for real-time speech,
#                            designed specifically for live conversation.
#                            Nova-2 model handles accents and noise well.
#
# Options:
#   stub        No external call. Returns placeholder text. Good for UI dev.
#   deepgram    ★ Best for real-time conversation. Streaming, ~200ms latency.
#   openai      OpenAI Whisper. Excellent accuracy. Slightly higher latency than Deepgram.
#   azure       Azure AI Speech. Solid, integrates with the rest of the Azure stack.
# ---------------------------------------------------------------------------
STT_PROVIDER=stub

# Required when STT_PROVIDER=deepgram:
# DEEPGRAM_API_KEY=...                 # deepgram.com — has a generous free tier
# DEEPGRAM_MODEL=nova-2                # nova-2 is current best; nova-3 in preview

# Required when STT_PROVIDER=openai:
# OPENAI_API_KEY=sk-...               # platform.openai.com
# STT_OPENAI_MODEL=whisper-1

# Required when STT_PROVIDER=azure:
# AZURE_SPEECH_KEY=...
# AZURE_SPEECH_REGION=uksouth          # e.g. uksouth, eastus

# ---------------------------------------------------------------------------
# Text-to-Speech (TTS)
#
# RECOMMENDATION for most realistic conversational feel:
#   TTS_PROVIDER=elevenlabs — the most natural-sounding voices available.
#                             Supports voice cloning so you can create a
#                             consistent persona voice. Turbo v2.5 model
#                             has ~300ms latency with streaming.
#
# Second best / easiest setup (same API key as Whisper):
#   TTS_PROVIDER=openai    — tts-1-hd with 'nova' or 'alloy' voice is very
#                            good and simple to configure.
#
# Options:
#   stub        No external call. Returns silent audio. Good for LLM/logic dev.
#   elevenlabs  ★ Best voice quality. Most realistic. Supports voice cloning.
#   openai      OpenAI TTS. Very good quality. tts-1-hd + nova voice recommended.
#   cartesia    Ultra-low latency (~90ms). New provider, excellent quality.
#   azure       Azure AI Speech neural voices. Solid. Good if already on Azure.
# ---------------------------------------------------------------------------
TTS_PROVIDER=stub

# Required when TTS_PROVIDER=elevenlabs:
# ELEVENLABS_API_KEY=...               # elevenlabs.io
# ELEVENLABS_VOICE_ID=...             # from your ElevenLabs voice library
# ELEVENLABS_MODEL=eleven_turbo_v2_5  # turbo for low latency; eleven_multilingual_v2 for quality

# Required when TTS_PROVIDER=openai:
# OPENAI_API_KEY=sk-...               # platform.openai.com (shares key with Whisper STT)
# TTS_OPENAI_MODEL=tts-1-hd           # tts-1 is faster; tts-1-hd is higher quality
# TTS_OPENAI_VOICE=nova               # voices: alloy, echo, fable, onyx, nova, shimmer

# Required when TTS_PROVIDER=cartesia:
# CARTESIA_API_KEY=...                # cartesia.ai
# CARTESIA_VOICE_ID=...               # from Cartesia voice library
# CARTESIA_MODEL=sonic-2              # sonic-2 is current production model

# Required when TTS_PROVIDER=azure:
# AZURE_SPEECH_KEY=...
# AZURE_SPEECH_REGION=uksouth
# TTS_AZURE_VOICE=en-GB-SoniaNeural   # any Azure neural voice name

# ---------------------------------------------------------------------------
# Azure observability (production only — injected via Managed Identity)
# ---------------------------------------------------------------------------
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# ---------------------------------------------------------------------------
# RAG / retrieval sources
# ---------------------------------------------------------------------------
# FTSE_API_URL=https://...
# FTSE_API_KEY=...                     # resolved via kv:ftse-api-key in production
