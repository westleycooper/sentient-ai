{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/auto-commit.sh",
            "timeout": 600,
            "async": true,
            "statusMessage": "Auto-committing (runs the full commit gate)…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-gate.sh" }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-generated-edit.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/check-boundaries.py" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bicep build:*)"
    ],
    "deny": [
      "Edit(packages/contracts/generated/**)",
      "Write(packages/contracts/generated/**)",
      "Bash(az deployment:*)",
      "Bash(az group deployment:*)",
      "Bash(bicep deploy:*)"
    ]
  }
}
